{
  "name": "azure-local-knowledge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Searchable troubleshooting index for Azure Local: Supportability TSGs + release known issues.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:index": "node scripts/build-index.mjs",
    "build:index:fixtures": "node scripts/build-index.mjs --fixtures",
    "fixtures:update": "node scripts/make-fixtures.mjs",
    "enrich": "node scripts/enrich.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.17.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
