{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://azure-local-knowledge/schema/enrichment.schema.json",
  "title": "Copilot enrichment response",
  "description": "What the enrichment model must return: one result per requested item.",
  "type": "object",
  "required": ["results"],
  "additionalProperties": false,
  "properties": {
    "results": {
      "type": "array",
      "items": { "$ref": "#/definitions/result" }
    }
  },
  "definitions": {
    "release": { "type": "string", "pattern": "^\\d{4}(\\.\\d+)?$" },
    "result": {
      "type": "object",
      "required": ["id", "confidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "versionRanges": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "oneOf": [{ "$ref": "#/definitions/release" }, { "type": "null" }] },
              "to": { "oneOf": [{ "$ref": "#/definitions/release" }, { "type": "null" }] },
              "note": { "type": ["string", "null"], "maxLength": 200 }
            }
          }
        },
        "osVersions": { "type": "array", "maxItems": 2, "items": { "enum": ["23H2", "24H2"] } },
        "errorAliases": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
        "normalizedErrors": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 3, "maxLength": 300 } },
        "symptomSummary": { "type": ["string", "null"], "maxLength": 220 },
        "mitigationSummary": { "type": ["string", "null"], "maxLength": 360 },
        "related": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "relation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "relation": { "enum": ["same-issue", "related", "supersedes", "workaround-for"] },
              "reason": { "type": ["string", "null"], "maxLength": 160 }
            }
          }
        },
        "flags": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["kind", "message"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["version-mismatch", "inconsistent", "duplicate", "stale", "broken-link", "unclear", "other"] },
              "message": { "type": "string", "minLength": 3, "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
